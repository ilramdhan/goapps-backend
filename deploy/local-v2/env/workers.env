# finance-cost-worker + finance-cost-orchestrator (and finance cmd/worker) share finance_db as finance_app via PgBouncer.
# Dev-only values. Switch: make v2-env-on (copies to services/finance-cost-{worker,orchestrator}/.env.local).
DATABASE_HOST=localhost
DATABASE_PORT=6440
DATABASE_USER=finance_app
DATABASE_PASSWORD=dev_finance_app
DATABASE_NAME=finance_db
DATABASE_SSLMODE=disable
