# ppc-service on the v2 local stack: runtime role via PgBouncer (ppc reads PPC_DATABASE_*).
# Dev-only values. Switch: make v2-env-on (copies to services/ppc/.env.local).
PPC_DATABASE_HOST=localhost
PPC_DATABASE_PORT=6440
PPC_DATABASE_USER=ppc_app
PPC_DATABASE_PASSWORD=dev_ppc_app
PPC_DATABASE_NAME=ppc_db
PPC_DATABASE_SSLMODE=disable
