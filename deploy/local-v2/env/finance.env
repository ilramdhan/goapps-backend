# finance-service on the v2 local stack (docker-compose.v2.yaml): runtime role via PgBouncer.
# Dev-only values. Switch: make v2-env-on (copies to services/<svc>/.env.local).
DATABASE_HOST=localhost
DATABASE_PORT=6440
DATABASE_USER=finance_app
DATABASE_PASSWORD=dev_finance_app
DATABASE_NAME=finance_db
DATABASE_SSLMODE=disable
