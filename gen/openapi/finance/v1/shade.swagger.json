          "description": "Total rows read from Oracle."
        },
        "inserted": {
          "type": "integer",
          "format": "int32",
          "description": "Rows newly inserted."
        },
        "updated": {
          "type": "integer",
          "format": "int32",
          "description": "Rows refreshed from Oracle."
        },
        "skipped": {
          "type": "integer",
          "format": "int32",
          "description": "Rows left untouched (MANUAL-owned, or an empty code)."
        },
        "durationMs": {
          "type": "string",
          "format": "int64",
          "description": "Wall-clock duration of the sync, in milliseconds."
        }
      },
      "description": "SyncShadesResponse reports the outcome of one sync run."
    },
