          "format": "int32",
          "description": "Total number of pages."
        }
      },
      "description": "PaginationResponse contains pagination metadata for list responses."
    },
    "v1Shade": {
      "type": "object",
      "properties": {
        "shadeId": {
          "type": "string",
          "format": "int64",
          "description": "Numeric primary key (ces_shade_id)."
        },
        "shadeCode": {
          "type": "string",
          "description": "Natural key, normalized upper-case (ces_shade_code). Immutable after creation."
        },
        "shadeName": {
          "type": "string",
          "description": "Display name (ces_shade_name)."
        },
        "shadeShortName": {
          "type": "string",
          "description": "Optional short name (ces_shade_short_name)."
        },
        "isActive": {
          "type": "boolean",
          "description": "Whether the shade is active (not frozen in Orion)."
        },
        "shadeSource": {
          "type": "string",
          "description": "Provenance: \"ORACLE\" (synced) or \"MANUAL\" (hand-authored)."
        },
