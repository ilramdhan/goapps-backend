          "type": "string",
          "description": "Oracle-side creation timestamp (ISO 8601), empty if unknown or MANUAL."
        },
        "sourceUpdatedAt": {
          "type": "string",
          "description": "Oracle-side update timestamp (ISO 8601), empty if unknown or MANUAL."
        },
        "sourceCreatedBy": {
          "type": "string",
          "description": "Oracle-side creator user id, empty if unknown or MANUAL."
        },
        "sourceUpdatedBy": {
          "type": "string",
          "description": "Oracle-side updater user id, empty if unknown or MANUAL."
        },
        "syncedAt": {
          "type": "string",
          "description": "Timestamp of the last successful Oracle sync (ISO 8601), empty if never synced."
        },
        "audit": {
          "$ref": "#/definitions/v1AuditInfo",
          "description": "Audit metadata."
        }
      },
      "description": "Shade represents one row of the shade master (cost_erp_shade)."
    },
    "v1SyncShadesRequest": {
      "type": "object",
      "description": "SyncShadesRequest triggers an Oracle-to-Postgres shade master sync. It\nfetches the full shade master from MGTDAT.OM_GRADE_CODE_2 and upserts into\ncost_erp_shade, keyed on shade_code. Rows a finance user created or edited\nby hand (source MANUAL) are never overwritten — see decideUpsertAction in\nthe Postgres repository. Runs synchronously; there is no background job or\npolling — the RPC returns once the sync completes."
    },
    "v1SyncShadesResponse": {
      "type": "object",
      "properties": {
        "base": {
          "$ref": "#/definitions/v1BaseResponse"
        },
