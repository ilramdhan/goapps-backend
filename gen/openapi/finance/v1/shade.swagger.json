  "paths": {
    "/api/v1/finance/shades": {
      "get": {
        "summary": "ListShades lists shades with search, filter, and pagination.",
        "operationId": "ShadeService_ListShades",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1ListShadesResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32"
          },
          {
            "name": "pageSize",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32"
          },
          {
            "name": "search",
            "description": "Full-text search across code, name, and short name.",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "activeFilter",
            "description": "Filter by active status.\n\n - ACTIVE_FILTER_UNSPECIFIED: Show all records regardless of active status (default).\n - ACTIVE_FILTER_ACTIVE: Show only active records.\n - ACTIVE_FILTER_INACTIVE: Show only inactive records.",
            "in": "query",
            "required": false,
            "type": "string",
            "enum": [
              "ACTIVE_FILTER_UNSPECIFIED",
              "ACTIVE_FILTER_ACTIVE",
              "ACTIVE_FILTER_INACTIVE"
            ],
            "default": "ACTIVE_FILTER_UNSPECIFIED"
          },
          {
            "name": "sourceFilter",
            "description": "Filter by provenance. Empty = both.",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "sortBy",
            "description": "Sort field.",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "sortOrder",
            "description": "Sort direction.",
            "in": "query",
            "required": false,
            "type": "string"
          }
        ],
        "tags": [
          "ShadeService"
        ]
      },
      "post": {
        "summary": "CreateShade creates a hand-authored (MANUAL) shade.",
        "operationId": "ShadeService_CreateShade",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1CreateShadeResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "description": "CreateShadeRequest creates a hand-authored (MANUAL) shade.",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v1CreateShadeRequest"
            }
          }
        ],
        "tags": [
          "ShadeService"
        ]
      }
    },
    "/api/v1/finance/shades/sync": {
      "post": {
        "summary": "SyncShades pulls the latest shade master from Oracle and upserts it into\ncost_erp_shade, skipping rows a finance user owns manually.",
        "operationId": "ShadeService_SyncShades",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1SyncShadesResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "description": "SyncShadesRequest triggers an Oracle-to-Postgres shade master sync. It\nfetches the full shade master from MGTDAT.OM_GRADE_CODE_2 and upserts into\ncost_erp_shade, keyed on shade_code. Rows a finance user created or edited\nby hand (source MANUAL) are never overwritten — see decideUpsertAction in\nthe Postgres repository. Runs synchronously; there is no background job or\npolling — the RPC returns once the sync completes.",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v1SyncShadesRequest"
            }
          }
        ],
        "tags": [
          "ShadeService"
        ]
      }
    },
    "/api/v1/finance/shades/{shadeId}": {
      "get": {
        "summary": "GetShade retrieves a Shade by id.",
        "operationId": "ShadeService_GetShade",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1GetShadeResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "shadeId",
            "in": "path",
            "required": true,
            "type": "string",
            "format": "int64"
          }
        ],
        "tags": [
          "ShadeService"
        ]
      },
      "delete": {
        "summary": "DeactivateShade soft-deactivates a Shade (ces_is_active = false). Not a\nhard delete — the row and its history are retained.",
        "operationId": "ShadeService_DeactivateShade",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1DeactivateShadeResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "shadeId",
            "in": "path",
            "required": true,
            "type": "string",
            "format": "int64"
          }
        ],
        "tags": [
          "ShadeService"
        ]
      },
      "put": {
        "summary": "UpdateShade updates a Shade's name, short name, and/or active status.",
        "operationId": "ShadeService_UpdateShade",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1UpdateShadeResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "shadeId",
            "in": "path",
            "required": true,
            "type": "string",
            "format": "int64"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/ShadeServiceUpdateShadeBody"
            }
          }
        ],
        "tags": [
          "ShadeService"
        ]
      }
    }
  },
  "definitions": {
    "ShadeServiceUpdateShadeBody": {
      "type": "object",
      "properties": {
        "shadeName": {
          "type": "string",
          "description": "Updated display name (max 300 chars)."
        },
        "shadeShortName": {
          "type": "string",
          "description": "Updated short name (max 60 chars)."
        },
        "isActive": {
          "type": "boolean",
          "description": "Updated active status."
        }
      },
      "description": "UpdateShadeRequest updates a Shade. The code is immutable — it is the key\nthe Oracle sync upserts on. Setting is_active=false is also the manual\ndeactivate path (equivalent to DeactivateShade)."
    },
