        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1ResolveCostProductMasterByErpCodeResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "description": "ResolveCostProductMasterByErpCode resolves ERP item/shade code pairs to CPM\nproducts. Used by PPC to link Orion sales-order staging rows to finance\nproduct masters (the two services own separate databases, so no SQL join is\navailable).",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v1ResolveCostProductMasterByErpCodeRequest"
            }
          }
        ],
        "tags": [
          "CostMasterLookupService"
        ]
      }
    },
